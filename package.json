{
  "name": "cotizador-ggis",
  "version": "1.0.0",
  "private": true,
  "description": "Cotizador GGIS — monolito modular (backend + front)",
  "type": "module",
  "workspaces": [
    "backend",
    "backend/domain",
    "front"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,front -c blue,magenta \"npm run dev -w @ggis/backend\" \"npm run dev -w @ggis/front\"",
    "build": "npm run build -w @ggis/front && npm run build -w @ggis/backend",
    "start": "npm run start -w @ggis/backend",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p backend/domain && tsc -p backend && tsc -p front",
    "lint": "eslint .",
    "format": "prettier --write .",
    "legacy:extract-assets": "node scripts/extract-legacy-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^5.0.3"
  }
}
