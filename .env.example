# Copia este archivo a .env y completa los valores. .env NUNCA se versiona.

# --- Servidor ---
NODE_ENV=development
# 127.0.0.1 = solo accesible desde este equipo. Cambia a 0.0.0.0 solo detrás de un proxy con autenticación.
HOST=127.0.0.1
API_PORT=4000
# Orígenes permitidos para CORS en desarrollo (el front de Vite)
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Datos ---
DATA_DIR=./data

# --- Extracción con IA (opcional) ---
# Si no se define, la extracción con IA queda deshabilitada y se usa el método de texto.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Investigación comercial de clientes con IA (opcional, OpenAI) ---
# Si no se define, la investigación automática queda deshabilitada (quedan los botones de Google).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Modelo para las imágenes alusivas de la oferta
OPENAI_IMAGE_MODEL=gpt-image-1.5

# --- Mapa de Google Maps en la oferta (opcional) ---
# Llave de Google Maps Platform con "Maps Static API" habilitada. Vacía = sin imagen del mapa.
GOOGLE_MAPS_API_KEY=

# --- Tasa de cambio ---
# Minutos que se cachea la TRM consultada
EXCHANGE_RATE_TTL_MIN=60
